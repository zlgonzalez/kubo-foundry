{
  "mcpServers": {
    "risingwave": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "RISINGWAVE_CONNECTION_STR",
        "-e",
        "MCP_TRANSPORT=stdio",
        "docker.io/risingwavelabs/risingwave-mcp-server:0.1.1"
      ],
      "env": {
        "RISINGWAVE_CONNECTION_STR": "postgresql://root:root@host.docker.internal:4566/dev"
      }
    }
  }
}
